# Copy to .env (same folder) and fill in from https://developer.spotify.com/dashboard
# Lets Jarvis resolve "metti One degli U2" to the exact track and auto-play it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Google Calendar + Gmail, READ-ONLY, for the morning briefing (see jarvis_bridge/google.py for the 5-step setup).
# Leave empty to keep the feature off. After filling in, open http://127.0.0.1:8765/google/login once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram bot (reminders on the phone + brain from anywhere). See jarvis_bridge/telegram.py. Empty = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional tuning
# JARVIS_CHAT_MODEL=qwen3.5:2b        # chat via the bridge (Ollama direct, streamed)
# JARVIS_EMBED_MODEL=nomic-embed-text # semantic memory search (ollama pull nomic-embed-text)
# JARVIS_BACKUP_DIR=D:\Backup\jarvis   # daily copy of data/brain.db (default data/backups)
# JARVIS_WAKE_THRESHOLD=0.5
# JARVIS_BRIDGE_PORT=8765
# JARVIS_INTENT_MODEL=qwen3.5:2b   # Ollama model for intent/brain extraction (default qwen3.5:4b)
